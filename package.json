{
  "name": "colombia-dominio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:server": "pnpm --filter @dominio/server dev",
    "dev:web": "pnpm --filter @dominio/web dev",
    "host": "node scripts/host.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "knip": "knip",
    "cpd": "jscpd",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm knip && pnpm cpd && pnpm check:ascii",
    "check:ascii": "node scripts/check-ascii.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
